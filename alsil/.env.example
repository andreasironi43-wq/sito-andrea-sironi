# Copia in .env.local (sviluppo) o imposta su Vercel > Settings > Environment Variables.
# Nessuna chiave va scritta nel codice.

# Dominio finale, senza slash finale. Governa canonical, og:url, sitemap, robots, JSON-LD.
SITE_URL=https://www.alsil.it

# Invio email del modulo preventivo (https://resend.com). Obbligatoria in produzione.
RESEND_API_KEY=
# Mittente: indirizzo su un dominio verificato in Resend.
QUOTE_FROM_EMAIL="Sito AL.SIL <preventivi@alsil.it>"
# Destinatario delle richieste.
QUOTE_TO_EMAIL=amministrazione@alsil.it

# Vercel Blob: abilita allegati oltre 4 MB (fino a 10 MB). Creato da Vercel > Storage > Blob.
BLOB_READ_WRITE_TOKEN=

# Analytics: usa UNO dei due. Caricati solo dopo consenso "statistiche".
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
NEXT_PUBLIC_GA4_ID=

# Marketing: caricati solo dopo consenso "marketing".
NEXT_PUBLIC_META_PIXEL_ID=
# Conversione Google Ads, formato AW-XXXXXXXXX/abcDEF123
NEXT_PUBLIC_GOOGLE_ADS_CONVERSION=
