# --- Negozio (Shopify headless) ---
# Senza queste due variabili il sito usa il catalogo di prova.
SHOPIFY_STORE_DOMAIN=andred.myshopify.com
SHOPIFY_STOREFRONT_TOKEN=
# Facoltative
SHOPIFY_API_VERSION=2026-07
SHOPIFY_COUNTRY=IT
SHOPIFY_WEBHOOK_SECRET=
# 1 = mostra "N pezzi rimasti" invece di solo Disponibile/Esaurito
SHOW_STOCK_COUNT=0
# Solo sviluppo: rende acquistabile il catalogo di prova
COMMERCE_DEMO=0

# --- Newsletter ---
# "mock" (default, solo log) — aggiungere qui i provider reali.
NEWSLETTER_PROVIDER=mock
# NEWSLETTER_API_KEY=
